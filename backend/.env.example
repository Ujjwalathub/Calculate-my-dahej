# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# API Configuration
API_TITLE="Startup Acquisition Valuation API"
API_VERSION="1.0.0"
API_DESCRIPTION="Advanced ML API with Neural Network (R²=0.9483)"
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration - explicit frontend dev-server origins only.
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:3001", "http://127.0.0.1:3001", "http://localhost:5173", "http://127.0.0.1:5173"]

# Model Configuration
MODEL_PATH=models/trained_models.pkl
PREPROCESSOR_PATH=models/preprocessor.pkl
CONFIDENCE_THRESHOLD=0.9

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/api.log

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
